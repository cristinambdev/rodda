@model SignUpViewModel
@{
    Layout = "_CleanLayout";
    ViewData["Title"] = "Create account";
}

<section id="signup">
  <div class="card">
    <div class="card-header">
      <div class="auth-brand">
        <img class="auth-brand-logo" src="~/images/logo.svg" width="91" height="85" alt="Rodda logo" decoding="async" />
      </div>
    </div>
    <div class="card-body">
      <h1 class="card-title">Create Account</h1>

        <form asp-controller="Auth" asp-action="ExternalLogin" method="post">
            <input type="hidden" name="provider" value="Google" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <button type="submit" class="btn btn-external">
                <img src="~/images/google_logo.svg" alt="Google logo" decoding="async" />
                Sign in with Google
            </button>
        </form>

      <p class="auth-divider" role="separator">OR</p>

      <form asp-controller="Auth" asp-action="SignUp" method="post" novalidate>
        <div asp-validation-summary="All" class="auth-error" role="alert"></div>

        <div class="form-group">
          <label class="form-label" for="DisplayName">Display name</label>
          <div class="form-input-field">
            <span class="form-input-field-icon" aria-hidden="true">
              <i class="fa-solid fa-user"></i>
            </span>
            <input asp-for="DisplayName" name="DisplayName" id="DisplayName" type="text" autocomplete="name" />
          </div>
          <span asp-validation-for="DisplayName" class="auth-error"></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="Email">Email</label>
          <div class="form-input-field">
            <span class="form-input-field-icon" aria-hidden="true">
              <i class="fa-solid fa-envelope"></i>
            </span>
            <input asp-for="Email" name="Email" id="Email" type="email" autocomplete="email" />
          </div>
          <span asp-validation-for="Email" class="auth-error"></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="Password">Password</label>
          <div class="form-input-field">
            <span class="form-input-field-icon" aria-hidden="true">
              <i class="fa-solid fa-lock"></i>
            </span>
            <input asp-for="Password" name="Password" id="Password" type="password" autocomplete="new-password" />
            <button type="button" class="form-input-field-toggle" data-password-toggle aria-controls="Password" aria-label="Show password">
              <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
            </button>
          </div>
          <span asp-validation-for="Password" class="auth-error"></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="ConfirmPassword">Confirm password</label>
          <div class="form-input-field">
            <span class="form-input-field-icon" aria-hidden="true">
              <i class="fa-solid fa-lock"></i>
            </span>
            <input asp-for="ConfirmPassword" name="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" />
            <button type="button" class="form-input-field-toggle" data-password-toggle aria-controls="ConfirmPassword" aria-label="Show password">
              <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
            </button>
          </div>
          <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
        </div>

        <button type="submit" class="btn btn-primary">Sign up</button>
      </form>
    </div>
    <div class="card-footer">
      Already have an account?
      <a href="/Auth/SignIn">Sign in</a>
    </div>
  </div>
</section>
