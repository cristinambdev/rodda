@model EventsViewModel
@using Domain.Enums
@using Domain.Models
@using System.Globalization
@{
    ViewData["Title"] = "Events";
    ViewData["UserId"] = Model.UserId;

    var now = DateTimeOffset.UtcNow;
    var upcomingEvents = Model.Events.Where(e => e.StartAt >= now).OrderBy(e => e.StartAt).ToList();
    var pastEvents = Model.Events.Where(e => e.StartAt < now).OrderByDescending(e => e.StartAt).ToList();
}

<!-- All Events page header -->
<div class="page-head">
    <div class="page-meta">
        <h1 class="page-title" id="allevents-heading">
            <i class="fa-solid fa-calendar-check"></i>
            All Events
        </h1>
        <p class="page-lead">Events you are actively part of.</p>
    </div>
    <div class="page-toolbar" role="toolbar" aria-label="Event list actions">
        <a class="events-list-toolbar-btn add-event-btn" href="/events/create" aria-label="Add event">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
        </a>
    </div>
</div>

<section class="page-section events-list-section-uncategorized" aria-labelledby="allevents-heading">
    <div data-allevents-list>
        <section class="events-list-panels" aria-labelledby="allevents-list-filter-label">
            <h2 class="visually-hidden" id="allevents-list-filter-label">Filter events by time</h2>
            <div class="segmented-control events-list-segment" role="group" aria-label="Event time range">
                <button type="button"
                        class="segmented-control-option active"
                        data-allevents-range="upcoming"
                        aria-pressed="true">
                    Upcoming
                </button>
                <button type="button"
                        class="segmented-control-option"
                        data-allevents-range="past"
                        aria-pressed="false">
                    Past events
                </button>
            </div>

            <div class="events-list-panel" data-allevents-panel="upcoming">
                @if (upcomingEvents.Count > 0)
                {
                    <ul class="page-items-list" data-allevents-list-items="upcoming">
                        @foreach (var ev in upcomingEvents)
                        {
                            <li class="events-list-item">
                                <partial name="~/Views/Shared/Partials/EventCardsPartials/_HorizontalEventCard.cshtml" model="ev" />
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-state-card events-list-empty" data-allevents-empty="upcoming">
                        No upcoming events.
                    </p>
                }
            </div>

            <div class="events-list-panel" data-allevents-panel="past" hidden>
                @if (pastEvents.Count > 0)
                {
                    <ul class="page-items-list" data-allevents-list-items="past">
                        @foreach (var ev in pastEvents)
                        {
                            <li class="events-list-item">
                                <partial name="~/Views/Shared/Partials/EventCardsPartials/_HorizontalEventCard.cshtml" model="ev" />
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-state-card events-list-empty" data-allevents-empty="past">
                        No past events.
                    </p>
                }
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/js/events-list-segment.js" asp-append-version="true"></script>
}
