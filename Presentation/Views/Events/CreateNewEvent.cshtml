@model Presentation.Models.AddEventViewModel
@{
    Layout = "_PortalLayout";
    var isEdit = Model.IsEdit;
    var eventModalModel = ViewData["EventDetailsModalModel"] as Presentation.Models.EventDetailsViewModel;
    var itemCount = eventModalModel?.Items?.Count ?? 0;
    var taskCount = eventModalModel?.Tasks?.Count ?? 0;
    ViewData["Title"] = isEdit ? "Edit Event" : "New Event";
    ViewData["EventModalDraft"] = !isEdit;
}

<!-- New event toolbar -->
<div class="newevent-toolbar">
    <button type="button" class="newevent-back" id="newevent-back" aria-label="Go back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    </button>
    <h1 class="newevent-title">@(isEdit ? "Edit Event" : "New Event")</h1>
</div>

<!-- New event form -->
<form class="newevent-form no-ajax"
      id="edit-event-form"
      asp-controller="Events"
      asp-action="@(isEdit ? "Edit" : "Add")"
      asp-route-id="@(isEdit ? Model.EventId : null)"
      method="post"
      enctype="multipart/form-data"
      novalidate
      data-is-new="@(isEdit ? "false" : "true")"
      data-event-id="@Model.EventId"
      data-return-url="@(isEdit ? Url.Action("EventDetails", "Events", new { id = Model.EventId }) : "/events")">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="auth-error" role="alert"></div>
    @if (isEdit)
    {
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="CoverImageUrl" id="cover-image-url" />
    }
    <!-- Event image input and preview -->
    <div class="newevent-cover-container">
        <input type="file" id="cover-input" name="cover" class="visually-hidden" accept="image/*" />
        <!-- The Upload Trigger (Camera Icon) -->
        <label class="cover-label" for="cover-input" id="cover-label-empty">
            <i class="fa-solid fa-camera" aria-hidden="true"></i>
            <span class="visually-hidden">Add event cover image</span>
        </label>
        <!-- The Preview (Only shows when image is selected) -->
        <div class="cover-preview" id="cover-preview" hidden>
            <img id="cover-img" alt="Cover preview" />
            <div class="cover-actions">
                <button type="button" id="cover-edit" aria-label="Edit"><i class="fa-solid fa-pen"></i></button>
                <button type="button" id="cover-delete" class="danger" aria-label="Delete"><i class="fa-solid fa-trash"></i></button>
            </div>
        </div>
    </div>

    <!-- Event title -->
    <div class="form-group">
        <label class="form-label" asp-for="Title">Title <span class="newevent-required" aria-hidden="true">*</span></label>
        <input asp-for="Title"
               id="newevent-title"
               class="form-input-field"
               placeholder="Write a name"
               autocomplete="off" />
        <span asp-validation-for="Title" class="auth-error"></span>
    </div>

    <!-- Event date and time -->
    <div class="form-group newevent-datetime-group">
        <div class="newevent-datetime-row">
            <div class="form-group">
                <label class="form-label" asp-for="Date">Date</label>
                <div class="form-input-field">
                    <i class="fa-regular fa-calendar form-input-field-icon" aria-hidden="true"></i>
                    <input asp-for="Date" id="newevent-date" type="date" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Time">Time</label>
                <div class="form-input-field">
                    <i class="fa-regular fa-clock form-input-field-icon" aria-hidden="true"></i>
                    <input asp-for="Time" id="newevent-time" type="time" />
                </div>
            </div>
        </div>
    </div>

    <!-- Event location -->
    <div class="form-group">
        <label class="form-label" for="newevent-location">Location</label>
        <div class="form-input-field">
            <i class="fa-solid fa-location-dot form-input-field-icon" aria-hidden="true"></i>
            <input id="newevent-location"
                   name="location"
                   type="text"
                   value="@Model.Location"
                   placeholder="Where is it?"
                   autocomplete="street-address" />
        </div>
    </div>

    <!-- Event description -->
    <div class="form-group newevent-description-group">
        <!-- Code generated with AI help -->
        <label class="form-label" for="newevent-description">Description</label>
        <div class="newevent-description-shell">
            <textarea id="newevent-description"
                      name="description"
                      class="form-input-field newevent-description-field"
                      rows="5"
                      placeholder="Tell people about it ...">@Model.Description</textarea>
            <div class="newevent-description-toolbar" role="toolbar" aria-label="Text formatting">
                <button type="button" class="newevent-toolbar-btn" aria-label="Bold" data-desc-cmd="bold">
                    <i class="fa-solid fa-bold" aria-hidden="true"></i>
                </button>
                <button type="button" class="newevent-toolbar-btn" aria-label="Italic" data-desc-cmd="italic">
                    <i class="fa-solid fa-italic" aria-hidden="true"></i>
                </button>
                <button type="button" class="newevent-toolbar-btn" aria-label="Underline" data-desc-cmd="underline">
                    <i class="fa-solid fa-underline" aria-hidden="true"></i>
                </button>
                <span class="newevent-toolbar-sep" aria-hidden="true"></span>
                <button type="button" class="newevent-toolbar-btn" aria-label="Align left">
                    <i class="fa-solid fa-align-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="newevent-toolbar-btn" aria-label="Align center">
                    <i class="fa-solid fa-align-center" aria-hidden="true"></i>
                </button>
                <button type="button" class="newevent-toolbar-btn" aria-label="Align right">
                    <i class="fa-solid fa-align-right" aria-hidden="true"></i>
                </button>
                <button type="button" class="newevent-toolbar-btn" aria-label="Link">
                    <i class="fa-solid fa-link" aria-hidden="true"></i>
                </button>
                <button type="button" class="newevent-toolbar-btn" aria-label="Bullet list">
                    <i class="fa-solid fa-list-ul" aria-hidden="true"></i>
                </button>
                <button type="button" class="newevent-toolbar-btn" aria-label="Numbered list">
                    <i class="fa-solid fa-list-ol" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Event payment -->
    <div class="form-group newevent-payment-group">
        <div class="newevent-payment-card newevent-disclosure" id="newevent-shared-payment">
            <button type="button"
                    class="newevent-disclosure-trigger"
                    id="newevent-payment-trigger"
                    aria-expanded="false"
                    aria-controls="newevent-payment-panel">
                <span class="newevent-disclosure-trigger-text">
                    <span class="form-label newevent-join-heading">Payment</span>
                    <span class="newevent-join-sub">Add payment details if you want to collect money for the event.</span>
                </span>
                <span class="newevent-disclosure-chevron" aria-hidden="true">
                    <i class="fa-solid fa-chevron-down"></i>
                </span>
            </button>

            <div class="newevent-payment-content" id="newevent-payment-panel" data-newevent-payment-panel hidden>
                <div class="newevent-payment-grid">
                    <label class="newevent-payment-field">
                        <span class="newevent-payment-label">Payment method</span>
                        <input type="text"
                               name="PaymentMethod"
                               value="@Model.PaymentMethod"
                               class="newevent-payment-input"
                               placeholder="e.g. swish, bank transfer, etc."
                               autocomplete="off" />
                    </label>
                    <label class="newevent-payment-field">
                        <span class="newevent-payment-label">Amount</span>
                        <input type="text"
                               name="PaymentAmount"
                               value="@Model.PaymentAmount"
                               placeholder="e.g. 50kr"
                               class="newevent-payment-input"
                               inputmode="text"
                               autocomplete="off" />
                    </label>
                    <label class="newevent-payment-field newevent-payment-field-full">
                        <span class="newevent-payment-label">Number</span>
                        <input type="tel"
                               name="PaymentNumber"
                               value="@Model.PaymentNumber"
                               class="newevent-payment-input"
                               placeholder="e.g. phone, bank number, etc."
                               inputmode="tel"
                               autocomplete="tel" />
                    </label>
                </div>
                <label class="newevent-payment-field newevent-payment-field-full newevent-payment-name-row">
                    <span class="newevent-payment-label">Name (and comments)</span>
                    <input type="text"
                           name="PaymentName"
                           value="@Model.PaymentName"
                           placeholder="e.g. Sarah"
                           class="newevent-payment-input"
                           autocomplete="name" />
                </label>
            </div>
        </div>
    </div>

    <!-- Event items and tasks -->
    <div class="form-group newevent-items-group">
        <div class="newevent-items-disclosure-card newevent-disclosure" id="newevent-items-tasks-card">
            <input type="hidden" name="ItemsTasksEnabled" id="newevent-items-tasks-enabled" value="@(Model.ItemsTasksEnabled == true ? "true" : "false")" />
            <input type="hidden" name="AllowGuestBringItems" id="newevent-allow-guest-items" value="@(Model.AllowGuestBringItems == true ? "true" : "false")" />
            <input type="hidden" name="AllowGuestTasks" id="newevent-allow-guest-tasks" value="@(Model.AllowGuestTasks == true ? "true" : "false")" />
            <input type="hidden" name="DraftBringItemsJson" id="newevent-draft-bring-items" value="[]" />
            <input type="hidden" name="DraftGuestTasksJson" id="newevent-draft-guest-tasks" value="[]" />
            <button type="button"
                    class="newevent-disclosure-trigger"
                    id="newevent-items-tasks-trigger"
                    aria-expanded="false"
                    aria-controls="newevent-items-panel">
                <span class="newevent-disclosure-trigger-text">
                    <span class="form-label newevent-items-heading-label">Include Items &amp; Tasks</span>
                    <span class="newevent-items-sub">Add items and tasks for this event and/or let guests add their own.</span>
                </span>
                <span class="newevent-disclosure-chevron" aria-hidden="true">
                    <i class="fa-solid fa-chevron-down"></i>
                </span>
            </button>
            <section class="newevent-items-section" id="newevent-items-panel" aria-label="Items and tasks">
                <div class="eventitem-mini-grid" data-eventitem-mini-grid="guest">
                    <!--Items to bring-->
                    <button type="button"
                            class="eventitem-mini-card eventitem-mini-card-items"
                            data-type="modal"
                            data-target="#eventitems-modal"
                            aria-expanded="false"
                            aria-haspopup="dialog">
                        <span class="eventitem-mini-icon-circle" aria-hidden="true">
                            <i class="fa-solid fa-box" aria-hidden="true"></i>
                        </span>
                        <span class="eventitem-mini-label">ITEMS TO BRING</span>
                        <span class="eventitem-mini-sub" id="eventitem-items-count">@itemCount item@(itemCount == 1 ? "" : "s")</span>
                    </button>
                    <!--Tasks to do-->
                    <button type="button"
                            class="eventitem-mini-card eventitem-mini-card-tasks"
                            data-open-eventtasks-modal
                            aria-haspopup="dialog"
                            aria-expanded="false"
                            aria-controls="eventtasks-modal">
                        <span class="eventtask-mini-icon-circle" aria-hidden="true">
                            <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>
                        </span>
                        <span class="eventtask-mini-label">TASKS TO DO</span>
                        <span class="eventtask-mini-sub" id="eventtasks-count">@taskCount task@(taskCount == 1 ? "" : "s")</span>
                    </button>
                </div>
            </section>
        </div>
    </div>

    <input type="hidden" asp-for="Timezone" />

    <!-- Event join button -->
    <div class="form-group newevent-join-group">
        <div class="newevent-join-block">
            <div class="newevent-join-copy">
                <div class="form-label newevent-join-heading" id="newevent-join-heading">Add Join button</div>
                <p class="newevent-join-sub">Track how many people will attend and let others see who has joined.</p>
            </div>
            <label class="newevent-switch">
                <input asp-for="JoinButton"
                       id="newevent-join-toggle"
                       aria-labelledby="newevent-join-heading" />
                <span class="newevent-switch-track" aria-hidden="true"></span>
            </label>
        </div>
    </div>

    <!-- Event chat -->
    <div class="form-group newevent-chat-group">
        <div class="newevent-join-block">
            <div class="newevent-join-copy">
                <div class="form-label newevent-join-heading" id="newevent-chat-heading">Include a chat section</div>
                <p class="newevent-join-sub">Let guests leave comments on the event page.</p>
            </div>
            <label class="newevent-switch">
                <input asp-for="ChatEnabled"
                       id="newevent-chat-toggle"
                       aria-labelledby="newevent-chat-heading" />
                <span class="newevent-switch-track" aria-hidden="true"></span>
            </label>
        </div>
    </div>

    <!-- Event submit button -->
    <div class="form-group">
        <button type="submit" class="btn btn-primary newevent-submit">@(isEdit ? "Save changes" : "Create event")</button>
    </div>
</form>

@{
    var eventModalViewData = new ViewDataDictionary(ViewData)
    {
        ["EventModalDraft"] = !isEdit
    };
}

<div id="eventitem-modals-root" data-event-modal-draft="@(isEdit ? "false" : "true")">
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemsModal.cshtml" model="eventModalModel" view-data="eventModalViewData" />
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemAddItemModal.cshtml" model="eventModalModel" view-data="eventModalViewData" />
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTasksModal.cshtml" model="eventModalModel" view-data="eventModalViewData" />
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTaskAddTaskModal.cshtml" model="eventModalModel" view-data="eventModalViewData" />
</div>
