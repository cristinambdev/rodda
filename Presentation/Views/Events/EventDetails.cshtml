@using Domain.Enums
@using Presentation.Helpers
@model Presentation.Models.EventDetailsViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = Model.Title;
    // Temp data for success and open modal messages
    ViewData["SuccessMessage"] = TempData["SuccessMessage"];
    ViewData["OpenModal"] = TempData["OpenModal"];
    // Item and task counts
    var itemCount = Model.Items?.Count ?? 0;
    var taskCount = Model.Tasks?.Count ?? 0;
    // Attendance counts: Accepted, Declined, Pending, Maybe
    var attendanceCounts = (
        Model.HostGuestRoster.Count(r => r.Status == Domain.Enums.AttendanceStatus.Accepted),
        Model.HostGuestRoster.Count(r => r.Status == Domain.Enums.AttendanceStatus.Declined),
        Model.HostGuestRoster.Count(r => r.Status is Domain.Enums.AttendanceStatus.Pending or Domain.Enums.AttendanceStatus.Maybe));
    // Current user ID
    var userId = User.GetUserId() ?? "";
    // Current user role
    var myRole = Model.EventRoles.FirstOrDefault(r => r.UserId == userId);
    // Is creator
    var isCreator = string.Equals(Model.CreatorDisplayLabel, "Myself", StringComparison.Ordinal);
    // Role badge: Creator, Owner, Co-owner
    string? roleBadge = isCreator ? "Creator"
        : myRole?.Role == EventRoleType.Owner ? "Owner"
        : myRole?.Role == EventRoleType.CoOwner ? "Co-owner"
        : null;
    // Current user attendance
    var myAttendance = Model.Attendees.FirstOrDefault(a => string.Equals(a.UserId, userId, StringComparison.Ordinal));
    // Show guest attendance badge
    var showGuestAttendanceBadge = myAttendance != null
        && string.IsNullOrEmpty(roleBadge)
        && myAttendance.Status != AttendanceStatus.Accepted;
    // Show hero badges
    var showHeroBadges = !string.IsNullOrEmpty(roleBadge) || Model.CanManageItemsTasks || showGuestAttendanceBadge;
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="auth-banner auth-banner--error" role="alert">@errorMessage</div>
}

<div id="event-details-page"
     data-event-id="@Model.Id"
     data-event-title="@Model.Title"
     data-can-manage="@(((ViewData["CanManageEvent"] as bool?) ?? false) ? "true" : "false")"
     data-open-modal="@(ViewData["OpenModal"] as string ?? "")"
     hidden></div>

<section class="eventitem-hero" aria-label="Event cover">
    <!-- Cover image -->
    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
    {
        <img id="eventitem-hero-img"
             class="eventitem-hero-image"
             src="@Model.CoverImageUrl"
             alt=""
             width="1200"
             height="675"
             decoding="async" />
    }
    else
    {
        <div id="eventitem-hero-placeholder"
             class="eventitem-hero-placeholder"
             role="img"
             aria-label="No cover image">
            <i class="fa-solid fa-camera" aria-hidden="true"></i>
        </div>
    }
    <div class="eventitem-hero-overlay">
        <!-- Hero badges: Role, Attendance -->
        @if (showHeroBadges)
        {
            <div class="eventitem-hero-badge-stack">

                @if (!string.IsNullOrEmpty(roleBadge))
                {
                    <!-- Role badge: Creator, Owner, Co-owner -->
                    <span class="badge @AttendanceStatusLabels.RoleBadgeCssClass eventitem-hero-role-badge">@roleBadge</span>
                }

                @if (Model.CanManageItemsTasks)
                {
                    <!-- Attendance badges: Accepted, Declined, Pending -->
                    <div class="badge eventitem-hero-attendance-badges" aria-label="Guest attendance summary">
                        <partial name="~/Views/Shared/Partials/EventDetailsPartials/_AttendanceSummaryBadges.cshtml" model="attendanceCounts" />
                    </div>
                }
            </div>
        }
        <!-- Go back button -->
        <a class="eventitem-hero-fab" id="eventitem-back" aria-label="Go back" asp-controller="Events" asp-action="Events">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <!-- Event options button -->
        <div class="eventitem-hero-options-wrap" data-menu-wrap>
            <button type="button"
                    class="eventitem-hero-fab"
                    id="eventitem-hero-options"
                    aria-label="Event options"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="event-details-context-menu"
                    data-menu-toggle>
                <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
            </button>
            <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsContextMenu.cshtml" />
        </div>
    </div>
</section>

<div class="eventitem-body">
    <!-- Event title and creator -->
    <div class="eventitem-title-block">
        <h3 class="eventitem-title" id="eventitem-title">@Model.Title</h3>
        <p class="eventitem-creator">
            Created by <strong id="eventitem-creator-name">@Model.CreatorDisplayLabel</strong>
        </p>
    </div>

    <!-- Event date and time -->
    <div class="eventitem-info-card">
        <div class="eventitem-info-row">
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            <p class="eventitem-info-text eventitem-info-date" id="eventitem-date-line">@Model.StartAt.ToString("dddd, MMM d")</p>
        </div>
        <div class="eventitem-info-row">
            <i class="fa-regular fa-clock" aria-hidden="true"></i>
            <p class="eventitem-info-text" id="eventitem-time">@Model.StartAt.ToString("HH:mm")</p>
        </div>
        <!-- Event location -->
        @if (Model.Location != null)
        {
            <div class="eventitem-info-row location">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <div>
                    <p class="eventitem-location-name" id="eventitem-location-name">@Model.Location.Name</p>
                    <p class="eventitem-location-address" id="eventitem-location-address">@Model.Location.Street</p>
                </div>
            </div>
        }
        <!-- Event payment variables -->
        @{
            var payment = Model.Payment;
            var hasPayment = payment != null && (
                !string.IsNullOrWhiteSpace(payment.Method)
                || !string.IsNullOrWhiteSpace(payment.Number)
                || !string.IsNullOrWhiteSpace(payment.Name)
                || payment.Amount.HasValue
                || !string.IsNullOrWhiteSpace(payment.Comment));
            string? paymentMethodLine = null;
            if (hasPayment)
            {
                var methodPart = payment!.Method?.Trim();
                var paymentTail = string.Join(" - ", new[]
                {
                    payment.Number?.Trim(),
                    payment.Name?.Trim()
                }.Where(s => !string.IsNullOrWhiteSpace(s)));
                paymentMethodLine = !string.IsNullOrWhiteSpace(methodPart)
                    ? (string.IsNullOrWhiteSpace(paymentTail) ? methodPart : $"{methodPart}: {paymentTail}")
                    : (string.IsNullOrWhiteSpace(paymentTail) ? null : paymentTail);
            }
        }
        <!-- Event payment display-->
        @if (hasPayment)
        {
            <hr class="eventitem-info-divider" />
            <div class="eventitem-info-row expenses">
                <i class="fa-solid fa-wallet" aria-hidden="true"></i>
                <div>
                    @if (!string.IsNullOrWhiteSpace(paymentMethodLine))
                    {
                        <p class="eventitem-payment-method-line" id="eventitem-payment-method-line">@paymentMethodLine</p>
                    }
                    @if (payment!.Amount.HasValue)
                    {
                        <p class="eventitem-amount-line" id="eventitem-amount-line">Amount: @payment.Amount.Value.ToString("0.##") kr</p>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Event description -->
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="eventitem-description">
            <p class="eventitem-description-label">DESCRIPTION:</p>
            <p id="eventitem-description" class="eventitem-description-text">@Model.Description</p>
        </div>
    }

    <!-- Guest contributions -->
    @if (Model.CanManageItemsTasks && Model.OrganizerContributions.Count > 0)
    {
        <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsGuestContributions.cshtml" model="Model" />
    }

    <!-- Join section -->
    <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsJoinSection.cshtml" model="Model" />

    <!-- Organizer and mini section -->
    @if (Model.ItemsTasksEnabled && !Model.CanManageItemsTasks)
    {
        <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsOrganizerAndMini.cshtml" model="Model" />
    }

    <!-- Chat section -->
    @if (Model.ChatEnabled)
    {
        <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsChat.cshtml" model="Model" />
    }
</div>

<!-- Modals -->
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsGuestsModal.cshtml" model="Model" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsAddCommunityGuestDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsJoinDialog.cshtml" model="Model" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsDeleteDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsShareDialog.cshtml" />

<!-- Modals for items and tasks -->
<div id="eventitem-modals-root">
    @Html.AntiForgeryToken()
    <!-- Event items modal -->
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemsModal.cshtml" model="Model" />
    <!-- Event items add item modal -->
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemAddItemModal.cshtml" model="Model" />
    <!-- Event tasks modal -->
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTasksModal.cshtml" model="Model" />
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTaskAddTaskModal.cshtml" model="Model" />
</div>

@section Scripts {
    <script src="~/js/eventdetails-join.js" asp-append-version="true"></script>
    @if (Model.ChatEnabled)
    {
        <script src="~/js/eventdetails-chat.js" asp-append-version="true"></script>
    }
}
