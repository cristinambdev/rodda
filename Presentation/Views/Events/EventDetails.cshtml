@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Event details";
}

<!-- Event hero -->
<section class="eventitem-hero" aria-label="Event cover">
    <img id="eventitem-hero-img"
         class="eventitem-hero-image"
         alt=""
         width="1200"
         height="675"
         decoding="async"
         hidden />
    <!-- Event hero buttons -->
    <div class="eventitem-hero-overlay">
        <button type="button" class="eventitem-hero-fab" id="eventitem-back" aria-label="Go back">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="eventitem-hero-fab" id="eventitem-hero-options" aria-label="Event options">
            <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
        </button>
    </div>
</section>
<!-- Event body -->
<div class="eventitem-body">
    <!-- Event title and creator -->
    <div class="eventitem-title-block">
        <h3 class="eventitem-title" id="eventitem-title"></h3>
        <p class="eventitem-creator">
            Created by <strong id="eventitem-creator-name"></strong>
        </p>
    </div>

    <!-- Event info card -->
    <div class="eventitem-info-card">
        <!-- Event date -->
        <div class="eventitem-info-row">
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            <p class="eventitem-info-text eventitem-info-date" id="eventitem-date-line"></p>
        </div>
        <!-- Event time -->
        <div class="eventitem-info-row">
            <i class="fa-regular fa-clock" aria-hidden="true"></i>
            <p class="eventitem-info-text" id="eventitem-time"></p>
        </div>
        <!-- Event location -->
        <div class="eventitem-info-row location">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <div>
                <p class="eventitem-location-name" id="eventitem-location-name"></p>
                <p class="eventitem-location-address" id="eventitem-location-address"></p>
            </div>
        </div>
        <!-- Event expenses line -->
        <hr class="eventitem-info-divider" />
        <div class="eventitem-info-row expenses">
            <i class="fa-solid fa-wallet" aria-hidden="true"></i>
            <div>
                <p class="eventitem-payment-method-line" id="eventitem-payment-method-line"></p>
                <p class="eventitem-amount-line" id="eventitem-amount-line"></p>
            </div>
        </div>
    </div>

    <!-- Event description -->
    <div class="eventitem-description">
        <p class="eventitem-description-label">DESCRIPTION:</p>
        <p id="eventitem-description" class="eventitem-description-text"></p>
    </div>

    <!-- Event join button -->
    <div class="eventitem-join" data-eventitem-guest-join>
        <button type="button" class="btn btn-primary btn-save-item">
            <span class="eventitem-join-label">JOIN</span>
            <span class="eventitem-join-pill">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                <span class="eventitem-join-pill-text">You joined</span>
            </span>
        </button>
        <button type="button"
                class="eventitem-join-count"
                id="eventitem-join-count-btn"
                aria-label="View who is attending"
                aria-haspopup="dialog"
                aria-controls="event-details-guests-modal">
            <i class="fa-solid fa-user-group" aria-hidden="true"></i>
            <span id="eventitem-join-badge" role="status"></span>
        </button>
    </div>

    <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsOrganizerAndMini.cshtml" />
    <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsChat.cshtml" />
</div>

<!-- Event item dialogues -->
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsGuestsModal.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsAddCommunityGuestDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsJoinDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsDeleteDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsShareDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsContextMenu.cshtml" />

<div id="eventitem-modals-root">
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemsModal.cshtml" />
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemAddItemModal.cshtml" />
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTasksModal.cshtml" />
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTaskAddTaskModal.cshtml" />
</div>
