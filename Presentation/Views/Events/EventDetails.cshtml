@model Presentation.Models.EventDetailsViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = Model.Title;
    var itemCount = Model.Items?.Count ?? 0;
    var taskCount = Model.Tasks?.Count ?? 0;
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="auth-banner auth-banner--success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="auth-banner auth-banner--error" role="alert">@errorMessage</div>
}

<section class="eventitem-hero" aria-label="Event cover">
    <img id="eventitem-hero-img"
         class="eventitem-hero-image"
         src="@Model.CoverImageUrl"
         alt=""
         width="1200"
         height="675"
         decoding="async"
         @(string.IsNullOrEmpty(Model.CoverImageUrl) ? "hidden" : null) />
    <div class="eventitem-hero-overlay">
        <a class="eventitem-hero-fab" id="eventitem-back" aria-label="Go back" asp-controller="Events" asp-action="Events">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <button type="button" class="eventitem-hero-fab" id="eventitem-hero-options" aria-label="Event options">
            <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
        </button>
    </div>
</section>

<div class="eventitem-body">
    <div class="eventitem-title-block">
        <h3 class="eventitem-title" id="eventitem-title">@Model.Title</h3>
        <p class="eventitem-creator">
            Created by <strong id="eventitem-creator-name">Organizer</strong>
        </p>
    </div>

    <div class="eventitem-info-card">
        <div class="eventitem-info-row">
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            <p class="eventitem-info-text eventitem-info-date" id="eventitem-date-line">@Model.StartAt.ToString("dddd, MMM d")</p>
        </div>
        <div class="eventitem-info-row">
            <i class="fa-regular fa-clock" aria-hidden="true"></i>
            <p class="eventitem-info-text" id="eventitem-time">@Model.StartAt.ToString("HH:mm")</p>
        </div>
        @if (Model.Location != null)
        {
            <div class="eventitem-info-row location">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <div>
                    <p class="eventitem-location-name" id="eventitem-location-name">@Model.Location.Name</p>
                    <p class="eventitem-location-address" id="eventitem-location-address">@Model.Location.Street</p>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="eventitem-description">
            <p class="eventitem-description-label">DESCRIPTION:</p>
            <p id="eventitem-description" class="eventitem-description-text">@Model.Description</p>
        </div>
    }

    @if (Model.ItemsTasksEnabled)
    {
        <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsOrganizerAndMini.cshtml" model="Model" />
    }

    @if (Model.ChatEnabled)
    {
        <partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsChat.cshtml" />
    }
</div>

<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsGuestsModal.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsAddCommunityGuestDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsJoinDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsDeleteDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsShareDialog.cshtml" />
<partial name="~/Views/Shared/Partials/EventDetailsPartials/_EventDetailsContextMenu.cshtml" />

<div id="eventitem-modals-root">
    @Html.AntiForgeryToken()
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemsModal.cshtml" model="Model" />
    <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemAddItemModal.cshtml" model="Model" />
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTasksModal.cshtml" model="Model" />
    <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTaskAddTaskModal.cshtml" model="Model" />
</div>
