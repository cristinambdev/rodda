@model EventsViewModel
@{
    ViewData["Title"] = "Community";
    Layout = "_PortalLayout";
}
<div class="page-head">
    <!-- Page header -->
    <div class="page-meta">
        <h1 class="page-title"><i class="fa-solid fa-users" aria-hidden="true"></i> Community</h1>
        <p class="page-lead">List of people that have accepted your invitations to events.</p>
    </div>
</div>

<section class="page-section">
    <!-- List of users -->
    <ul class="page-items-list community" data-community-users></ul>
    <div class="empty-state-card community" data-community-empty hidden>No people yet.</div>

    <!-- Member card -->
    <template id="member-card-template">
        <li class="member-item">
            <article class="card member-card">
                <div class="card-body">
                    <!-- Member card Avatar + name -->
                    <div class="member-card-row">
                        <span class="member-avatar" aria-hidden="true">AA</span>
                        <div class="member-card-content">
                            <div class="member-card-title-row">
                                <h3 class="member-card-title">Name</h3>
                                <button type="button"
                                        class="member-card-remove"
                                        aria-label="Remove from Community list">
                                    <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                                </button>
                            </div>
                            <!-- Member card common events -->
                            <div class="member-shared" aria-label="Shared items">
                                <span class="member-shared-item">
                                    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                                    <span class="member-shared-text">Event name</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer"></div>
            </article>
        </li>
    </template>

    <!-- One shared chip row (event) -->
    <template id="member-shared-row-template">
        <span class="member-shared-item">
            <i class="member-shared-kind-icon fa-regular fa-calendar" aria-hidden="true"></i>
            <span class="member-shared-text"></span>
        </span>
    </template>
</section>

<partial name="~/Views/Shared/Partials/CommunityPartials/_CommunityRemoveMemberDialog.cshtml" />
