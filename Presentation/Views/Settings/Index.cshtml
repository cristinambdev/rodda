@{
    ViewData["Title"] = "Settings";
}

<div class="settings-page">
    <div class="page-head">
        <div class="page-meta">
            <h1 class="page-title settings-title" id="settings-heading">
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                Settings
            </h1>
        </div>
    </div>

    <section class="settings-profile-card" aria-labelledby="settings-profile-heading">
        <h2 class="visually-hidden" id="settings-profile-heading">Your profile</h2>
        <p class="page-lead">Account preferences will be available here soon.</p>
    </section>
</div>
