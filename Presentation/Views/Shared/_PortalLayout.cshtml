<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="~/images/logo.svg" type="image/svg+xml" />
    <meta name="description" content="Rodda — account" />
    <link rel="stylesheet" href="~/css/common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/eventitem.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/newevent.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/community.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/771aedd07a.js" crossorigin="anonymous"></script>
    <title>@ViewData["Title"] | Rodda</title>
</head>
<body
    data-portal-shell
    data-settings-url="@Url.Action("Index", "Settings")"
    data-sign-in-url="@Url.Action("SignIn", "Auth")"
    data-active-nav="@ViewData["ActiveNav"]"
>
    <form id="portal-logout-form" asp-controller="Auth" asp-action="Logout" method="post" hidden>
        @Html.AntiForgeryToken()
    </form>

    <div class="main-layout">

        <partial name="~/Views/Shared/Partials/LayoutPartials/_Header.cshtml" />

        <main class="app-main" id="main-content">
            @RenderBody()
        </main>

        <partial name="~/Views/Shared/Partials/LayoutPartials/_BottomNav.cshtml" />
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/event-items-tasks.js" asp-append-version="true"></script>
    <script src="~/js/newevent.js" asp-append-version="true"></script>
    <script src="~/js/eventdetails-modals.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
