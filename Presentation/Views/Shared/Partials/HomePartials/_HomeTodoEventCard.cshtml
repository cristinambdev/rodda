@model Presentation.Models.HomeTodoEventCardViewModel
@{
    var theme = Model.CardTheme;
    var badgeText = $"{Model.DoneCount}/{Model.LineCount} done";
}

<li class="todo-item">
    <details class="todo-task-card @theme" data-event-id="@Model.EventId">
        <summary class="todo-task-card-summary">
            <span class="todo-task-card-accent" aria-hidden="true"></span>
            <div class="todo-task-card-inner">
                <div class="todo-task-card-header-row">
                    <h3 class="todo-task-card-title">
                        <a class="todo-task-card-title-link"
                           href="@Model.DetailUrl"
                           aria-label="View event: @Model.Title">@Model.Title</a>
                    </h3>
                    <span class="todo-task-card-badge @theme">@badgeText</span>
                    <span class="todo-task-card-chevron" aria-hidden="true">
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="todo-task-card-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.DatePart))
                    {
                        <span class="todo-task-card-meta-item">
                            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                            @Model.DatePart
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TimePart))
                    {
                        <span class="todo-task-card-meta-item">
                            <i class="fa-regular fa-clock" aria-hidden="true"></i>
                            @Model.TimePart
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ListLocation))
                    {
                        <span class="todo-task-card-meta-item">
                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                            @Model.ListLocation
                        </span>
                    }
                </div>
            </div>
        </summary>
        <div class="todo-task-card-body">
            <ul class="todo-task-lines">
                @foreach (var item in Model.BringItems)
                {
                    <li class="todo-task-line@(item.Done ? " done" : "")">
                        <span class="todo-task-line-check" aria-hidden="true">
                            <i class="@(item.Done ? "fa-solid fa-circle-check" : "fa-regular fa-circle")" aria-hidden="true"></i>
                        </span>
                        <div class="todo-task-line-main">
                            <div class="todo-task-line-row">
                                <span class="todo-task-line-name">@item.Title</span>
                                @if (!string.IsNullOrWhiteSpace(item.Amount))
                                {
                                    <span class="todo-task-line-qty">@item.Amount</span>
                                }
                                <span class="todo-task-line-tag todo-task-line-tag-item">Item</span>
                            </div>
                        </div>
                    </li>
                }
                @foreach (var task in Model.GuestTasks)
                {
                    <li class="todo-task-line@(task.Done ? " done" : "")">
                        <span class="todo-task-line-check" aria-hidden="true">
                            <i class="@(task.Done ? "fa-solid fa-circle-check" : "fa-regular fa-circle")" aria-hidden="true"></i>
                        </span>
                        <div class="todo-task-line-main">
                            <div class="todo-task-line-row">
                                <span class="todo-task-line-name">@task.Title</span>
                                <span class="todo-task-line-tag todo-task-line-tag-task">Task</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(task.TaskTime) || !string.IsNullOrWhiteSpace(task.TaskLocation))
                            {
                                <div class="todo-task-line-submeta todo-task-line-submeta-icons">
                                    @if (!string.IsNullOrWhiteSpace(task.TaskTime))
                                    {
                                        <span>
                                            <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                            @task.TaskTime
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(task.TaskLocation))
                                    {
                                        <span>
                                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                            @task.TaskLocation
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </details>
</li>
