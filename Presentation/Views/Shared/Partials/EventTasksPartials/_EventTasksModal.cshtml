@using System.Security.Claims
@model Presentation.Models.EventDetailsViewModel?
@{
    var eventId = Model?.Id ?? ViewContext.RouteData.Values["id"]?.ToString() ?? "";
    var tasks = Model?.Tasks ?? new List<Presentation.Models.EventTaskViewModel>();
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canManage = Model?.CanManageItemsTasks == true;
}

<div id="eventtasks-modal"
     class="modal modal-event-tasks"
     data-eventtasks-modal
     data-can-manage="@(canManage ? "true" : "false")"
     role="presentation">
  <button type="button" class="modal-backdrop" data-type="close" data-target="#eventtasks-modal" tabindex="-1" aria-label="Close"></button>
  <div class="modal-panel edit-add-task-dialogue" role="dialog" aria-modal="true" aria-labelledby="eventtasks-modal-title">
    <button
      type="button"
      id="eventtasks-modal-dismiss"
      class="modal-dismiss modal-dismiss-corner"
      data-type="close"
      data-target="#eventtasks-modal"
      aria-label="Close"
    >
      ×
    </button>

    <header class="modal-header">
      <span class="modal-header-icon" aria-hidden="true">
        <i class="fa-solid fa-clipboard-check"></i>
      </span>
      <div class="modal-header-text">
        <h2 class="modal-title" id="eventtasks-modal-title">Tasks to do</h2>
        <p class="modal-subtitle" id="eventtasks-modal-subtitle">@(Model?.Title?.ToUpperInvariant())</p>
      </div>
    </header>

    <div class="modal-content modal-content-eventtasks">
      <div id="eventtasks-modal-list" class="modal-list">
        <div class="modal-list-scroll">
          <div id="eventtasks-modal-rows" class="modal-list-rows">
            @if (tasks.Count == 0)
            {
              <p class="modal-empty">No tasks listed yet.</p>
            }
            @foreach (var task in tasks)
            {
              <partial name="~/Views/Shared/Partials/EventTasksPartials/_EventTaskRow.cshtml"
                       model="(task, eventId, currentUserId, canManage)" />
            }
          </div>
        </div>
      </div>
    </div>

    <div class="add-event-tasks-container">
      @if (canManage)
      {
      <button type="button" class="modal-content-add task" id="eventtasks-modal-add" data-type="modal" data-target="#eventitem-add-task-modal" data-close-parent="#eventtasks-modal" data-reset-add-task>
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>ADD A TASK</span>
      </button>

      <div class="newtask-join-block" id="eventtasks-guest-policy-row">
        <div class="newtask-join-copy">
          <label class="form-label" for="eventitem-allow-guest-tasks-toggle">Let people add their own tasks</label>
        </div>
        <label class="newetask-switch">
          <input type="checkbox" id="eventitem-allow-guest-tasks-toggle" name="allowGuestTasks" value="1" @(Model?.AllowGuestTasks == true ? "checked" : null) />
          <span class="newetask-switch-track" aria-hidden="true"></span>
        </label>
      </div>
      }
    </div>

    <footer class="modal-footer modal-footer-eventtasks">
      <button type="button" class="btn btn-save-task" id="eventtasks-modal-save" data-type="close" data-target="#eventtasks-modal">
        <span class="eventitem-join-label">DONE</span>
      </button>
    </footer>
  </div>
</div>
