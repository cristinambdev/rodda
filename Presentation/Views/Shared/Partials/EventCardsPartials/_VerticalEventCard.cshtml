@model Event
@using Domain.Enums
@using Presentation.Helpers
@using System.Globalization

@{
    var userId = ViewData["UserId"] as string ?? "";
    var start = Model.StartAt;
    var isPast = start < DateTimeOffset.UtcNow;
    var hasCover = !string.IsNullOrWhiteSpace(Model.CoverImageUrl);
    var title = Model.Title;
    var detailUrl = Model.DetailsPath();
    var listDateTime = start.ToString("ddd, MMM d · h:mm tt", CultureInfo.InvariantCulture);
    var listLocation = !string.IsNullOrWhiteSpace(Model.Location?.Name)
        ? Model.Location!.Name!
        : Model.Location?.Street ?? "";

    // Role and attendance badges
    var role = Model.Roles.FirstOrDefault(r => r.UserId == userId);
   var isCreator = !string.IsNullOrEmpty(Model.CreatedByUserId)
        && string.Equals(Model.CreatedByUserId, userId, StringComparison.Ordinal);
    var isHost = isCreator
        || role?.Role == EventRoleType.Owner
        || role?.Role == EventRoleType.CoOwner;
    string? roleBadge = isCreator ? "Creator"
        : role?.Role == EventRoleType.Owner ? "Owner"
        : role?.Role == EventRoleType.CoOwner ? "Co-owner"
        : null;
    var attendanceCounts = AttendanceCounts.From(Model.Attendances);
    var myAttendance = Model.Attendances.FirstOrDefault(a => a.UserId == userId && !a.HiddenFromList);

    var accepted = Model.Attendances.Where(a => a.Status == AttendanceStatus.Accepted).ToList();
    var attendanceMuted = accepted.Count == 0;

    var attendanceIcon = "fa-solid fa-users";
    var attendanceLabel = accepted.Count == 0
        ? "No one has joined yet"
        : (accepted.Sum(a => Math.Max(1, a.GuestCount)) == 1
            ? "1 person attending"
            : $"{accepted.Sum(a => Math.Max(1, a.GuestCount))} people attending");

    var workloadBadges = ViewData["EventCardBadges"] is IReadOnlyDictionary<string, EventCardBadgeHelper.CardBadges> cardBadges
        ? cardBadges.GetValueOrDefault(Model.Id)
        : null;

    var cardClass = "card event-card vertical" + (isPast ? " event-card--past" : "");
    var attendanceClass = "event-card-attendance" + (attendanceMuted ? " event-card-attendance--muted" : "");
    var headerClass = "card-header event-card-header" + (hasCover ? "" : " event-card-header--no-photo");
    var footerSolo = string.IsNullOrWhiteSpace(listLocation);
    var footerClass = "card-footer" + (footerSolo ? " solo" : "");
}

<article class="@cardClass" data-event-card data-event-id="@Model.Id">
    <a class="event-card-link-overlay"
       href="@detailUrl"
       aria-label="View @title"></a>

    <div class="@headerClass">
        @if (!string.IsNullOrEmpty(roleBadge) || isHost || myAttendance != null)
        {
            <div class="event-card-badge-stack">
            @if (!string.IsNullOrEmpty(roleBadge))
                {
                    <!-- Role badge: Creator, Owner, Co-owner -->
                    <span class="badge @AttendanceStatusLabels.RoleBadgeCssClass event-card-role-badge">@roleBadge</span>
                }
                @if (isHost)
                {
                    <!-- Guest summary of (Accepted, Declined, Pending) for host counting-->
                    <div class="event-card-attendance-badge" aria-label="Guest attendance summary">
                        <partial name="~/Views/Shared/Partials/EventDetailsPartials/_AttendanceSummaryBadges.cshtml" model="attendanceCounts" />
                    </div>
                }
                else if (myAttendance != null)
                {
                    <!-- User own attendance badges: Accepted, Declined, Pending -->
                    <span class="badge @AttendanceStatusLabels.BadgeCssClass(myAttendance.Status) event-attendance-badge">
                        @AttendanceStatusLabels.BadgeLabel(myAttendance.Status)
                    </span>
                }
            </div>
            <div class="event-card-status-stack">
                <!-- Workload badge: Claimed, Unclaimed items/tasks amount -->
                @if (workloadBadges != null && !string.IsNullOrEmpty(workloadBadges.WorkloadLabel))
                {
                    <span class="badge badge-blue">@workloadBadges.WorkloadLabel</span>
                }
                <!-- You have tasks/items badge -->
                @if (workloadBadges?.UserHasItemsOrTasks == true)
                {
                    <span class="badge badge-orange status-you">You have tasks/items</span>
                }
            </div>
        }
        @if (hasCover)
        {
            <img class="event-card-image"
                 src="@Model.CoverImageUrl"
                 alt=""
                 width="800"
                 height="450"
                 decoding="async" />
        }
        else
        {
            <div class="event-card-hero-placeholder event-card-hero-placeholder--home" aria-hidden="true">
                <i class="fa-solid fa-camera" aria-hidden="true"></i>
            </div>
        }
    </div>

    <div class="card-body">
        <h3 class="event-card-title">@title</h3>
        <p class="event-card-datetime">@listDateTime</p>
        @if (!string.IsNullOrWhiteSpace(listLocation))
        {
            <p class="event-card-location">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                @listLocation
            </p>
        }
    </div>

    <div class="@footerClass">
        <p class="@attendanceClass">
            <i class="@attendanceIcon" aria-hidden="true"></i>
            @attendanceLabel
        </p>
    </div>
</article>
