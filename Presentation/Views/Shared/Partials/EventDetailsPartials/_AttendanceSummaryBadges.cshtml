@using Domain.Enums
@using Presentation.Helpers
@model (int Accepted, int Declined, int Pending)
@{
    var items = new List<(string Label, string Class)>();
    if (Model.Accepted > 0)
        items.Add((AttendanceStatusLabels.BadgeLabel(AttendanceStatus.Accepted), AttendanceStatusLabels.BadgeCssClass(AttendanceStatus.Accepted)));
    if (Model.Declined > 0)
        items.Add((AttendanceStatusLabels.BadgeLabel(AttendanceStatus.Declined), AttendanceStatusLabels.BadgeCssClass(AttendanceStatus.Declined)));
    if (Model.Pending > 0)
        items.Add((AttendanceStatusLabels.BadgeLabel(AttendanceStatus.Pending), AttendanceStatusLabels.BadgeCssClass(AttendanceStatus.Pending)));
}
@if (items.Count > 0)
{
    @foreach (var item in items)
    {
        <span class="event-attendance-badge @item.Class">@item.Label</span>
    }
}
