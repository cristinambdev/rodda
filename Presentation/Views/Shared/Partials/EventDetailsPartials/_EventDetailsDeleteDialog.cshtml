<!-- Delete event confirmation modal -->
<div id="event-details-delete-dialog" class="modal event-details-delete-dialogue" role="presentation">
  <button type="button"
          class="modal-backdrop"
          data-type="close"
          data-target="#event-details-delete-dialog"
          tabindex="-1"
          aria-label="Close"></button>
  <div class="modal-panel card event-details-delete-dialogue-panel"
       role="dialog"
       aria-modal="true"
       aria-labelledby="event-details-delete-dialog-heading">
    <div class="card-header event-details-delete-dialogue-header">
      <button type="button"
              class="btn-close event-details-delete-dialogue-close modal-dismiss"
              data-type="close"
              data-target="#event-details-delete-dialog"
              aria-label="Close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="card-body event-details-delete-dialogue-body">
      <i class="fa-regular fa-trash-can icon" aria-hidden="true"></i>
      <h5 class="event-details-delete-dialogue-heading" id="event-details-delete-dialog-heading">Delete event?</h5>
      <p class="event-details-delete-dialogue-text">
        You are about to delete "<strong id="event-details-delete-event-name">this event</strong>".
        <br />
        Choose how you want to proceed:
      </p>
      <div class="event-details-delete-dialogue-actions">
        <a class="btn delete-action delete-action-own-list" href="/events">
          Delete from my list
        </a>
        <button type="button"
                class="btn delete-action delete-action-everyone"
                data-event-details-delete-action="everyone">
          Delete for everyone
        </button>
      </div>
    </div>
  </div>
</div>
