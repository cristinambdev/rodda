@{
    var canManageEvent = ViewData["CanManageEvent"] as bool? ?? false;
}
<!-- Context menu for event details -->
<div id="event-details-context-menu"
     class="event-card-context-menu event-details-context-menu--hero"
     role="menu"
     hidden>
  <button type="button" class="event-card-context-menu-item" role="menuitem" data-event-details-menu-action="share">
    <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
    <span>Share</span>
  </button>
  <button type="button"
          class="event-card-context-menu-item"
          role="menuitem"
          data-event-details-menu-action="edit"
          @(canManageEvent ? null : "hidden")>
    <i class="fa-solid fa-pen" aria-hidden="true"></i>
    <span>Edit</span>
  </button>
  <button type="button"
          class="event-card-context-menu-item danger"
          role="menuitem"
          data-event-details-menu-action="delete"
          @(canManageEvent ? null : "hidden")>
    <i class="fa-solid fa-trash" aria-hidden="true"></i>
    <span>Delete</span>
  </button>
</div>

