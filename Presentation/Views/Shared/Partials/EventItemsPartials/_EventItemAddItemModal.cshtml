@model Presentation.Models.EventDetailsViewModel?
@{
    var isDraft = ViewData["EventModalDraft"] as bool? == true
        || string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "CreateNewEvent", StringComparison.OrdinalIgnoreCase)
        || (ViewContext.HttpContext.Request.Path.Value?.StartsWith("/events/create", StringComparison.OrdinalIgnoreCase) ?? false);
    var eventId = Model?.Id ?? ViewContext.RouteData.Values["id"]?.ToString();
    var canPost = !isDraft && !string.IsNullOrEmpty(eventId) && Model?.CanAddItems == true;
    var canDraft = isDraft;
}

<!--  Add/edit item  modal -->
<div id="eventitem-add-item-modal" class="modal modal-add-item" role="presentation">
  <button type="button" class="modal-backdrop" data-type="close" data-target="#eventitem-add-item-modal" data-reopen="#eventitems-modal" tabindex="-1" aria-label="Close"></button>
  <div
    id="eventitem-add-item-dialogue"
    class="modal-panel edit-add-item-dialogue form"
    role="dialog"
    aria-modal="true"
    aria-labelledby="eventitem-add-item-modal-title"
    data-is-new="true"
  >

    <!-- Modal header -->
    <header class="modal-header-split">
      <div class="modal-header-lead">
        <span class="modal-header-icon" aria-hidden="true">
          <i class="fa-solid fa-box-open"></i>
        </span>
        <div class="modal-header-text">
          <h2 class="modal-title" id="eventitem-add-item-modal-title">Add item</h2>
          <p class="modal-subtitle" id="eventitem-add-item-modal-subtitle"></p>
        </div>
      </div>
      <button type="button" class="modal-dismiss" data-type="close" data-target="#eventitem-add-item-modal" data-reopen="#eventitems-modal" aria-label="Close">×</button>
    </header>

    @if (canPost)
    {
    <form id="eventitem-add-item-form"
          class="add-item-form"
          method="post"
          asp-controller="EventItems"
          asp-action="CreateItem"
          asp-route-eventId="@eventId"
          data-edit-url-template="@Url.Action("EditItem", "EventItems", new { eventId = eventId, itemId = "__ITEMID__" })">
      @Html.AntiForgeryToken()
      <input type="hidden" id="eventitem-add-item-id" value="" />
      <input type="hidden" name="SignupMode" value="@((int)Domain.Enums.SignupMode.Available)" />
      <input type="hidden" name="SortOrder" value="0" />
      <input type="hidden" name="IsActive" value="true" />
      <div class="modal-content modal-content-padded">
        <!-- Name -->
        <div class="add-item-card">
          <label class="add-item-label" for="eventitem-add-item-name">
            ITEM NAME<span class="add-item-required" aria-hidden="true">*</span>
          </label>
          <input
            id="eventitem-add-item-name"
            name="Title"
            class="add-item-input"
            type="text"
            autocomplete="off"
            placeholder="e.g. coffee, napkins"
            required
          />

          <!-- Amount -->
          <div class="add-item-row">
            <div class="add-item-field">
              <label class="add-item-label" for="eventitem-add-item-amount">AMOUNT</label>
              <input
                id="eventitem-add-item-amount"
                name="Amount"
                class="add-item-input"
                type="text"
                autocomplete="off"
                placeholder="e.g. 1 kg, 2 boxes"
              />
            </div>

            <!-- Amount of people needed -->
            <div class="add-item-field">
              <label class="add-item-label" for="eventitem-add-item-people">PEOPLE NEEDED</label>
              <div class="add-item-people">
                <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                <input
                  id="eventitem-add-item-people"
                  name="PeopleNeeded"
                  class="add-item-input add-item-input--people"
                  type="number"
                  min="1"
                  max="99"
                  step="1"
                  inputmode="numeric"
                  value="1"
                  aria-label="People needed"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal footer -->
      <footer class="modal-footer modal-footer-add-item">
        <button type="submit" class="btn btn-add-item" id="eventitem-add-item-save">
          <span class="eventitem-join-label">SAVE</span>
          <span class="eventitem-join-pill">
            <i class="fa-solid fa-check" aria-hidden="true"></i>
            Saved
          </span>
        </button>
      </footer>
    </form>
    }
    else if (canDraft)
    {
    <form id="eventitem-add-item-form"
          class="add-item-form no-ajax"
          method="post"
          action="#"
          data-draft-only="true"
          novalidate>
      <div class="modal-content modal-content-padded">
        <div class="add-item-card">
          <label class="add-item-label" for="eventitem-add-item-name">
            ITEM NAME<span class="add-item-required" aria-hidden="true">*</span>
          </label>
          <input
            id="eventitem-add-item-name"
            name="Title"
            class="add-item-input"
            type="text"
            autocomplete="off"
            placeholder="e.g. coffee, napkins"
            required
          />
          <div class="add-item-row">
            <div class="add-item-field">
              <label class="add-item-label" for="eventitem-add-item-amount">AMOUNT</label>
              <input
                id="eventitem-add-item-amount"
                name="Amount"
                class="add-item-input"
                type="text"
                autocomplete="off"
                placeholder="e.g. 1 kg, 2 boxes"
              />
            </div>
            <div class="add-item-field">
              <label class="add-item-label" for="eventitem-add-item-people">PEOPLE NEEDED</label>
              <div class="add-item-people">
                <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                <input
                  id="eventitem-add-item-people"
                  name="PeopleNeeded"
                  class="add-item-input add-item-input--people"
                  type="number"
                  min="1"
                  max="99"
                  step="1"
                  inputmode="numeric"
                  value="1"
                  aria-label="People needed"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="modal-footer modal-footer-add-item">
        <button type="submit" class="btn btn-add-item" id="eventitem-add-item-save">
          <span class="eventitem-join-label">SAVE</span>
        </button>
      </footer>
    </form>
    }
    else
    {
    <p class="modal-empty modal-content-padded">You cannot add items for this event. Join the event or ask the organizer to allow guest items.</p>
    }
  </div>
</div>
