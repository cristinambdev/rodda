@model Presentation.Models.EventDetailsViewModel?
@{
    var isDraft = ViewData["EventModalDraft"] as bool? == true;
    var eventId = Model?.Id ?? ViewContext.RouteData.Values["id"]?.ToString() ?? "";
    var items = Model?.Items ?? new List<Presentation.Models.EventItemViewModel>();
    var currentUserId = User.GetUserId();
    var canManage = Model?.CanManageItemsTasks == true || isDraft;
    var canAddItems = Model?.CanAddItems == true || isDraft;
    var canClaimItems = Model?.CanClaimItems == true || isDraft;
    var modalFlash = ViewData["SuccessMessage"] as string;
    var showModalFlash = string.Equals(ViewData["OpenModal"] as string, "items", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(modalFlash);
}

<div id="eventitems-modal"
     class="modal modal-event-items"
     data-eventitems-modal
     data-can-manage="@(canManage ? "true" : "false")"
     data-can-add="@(canAddItems ? "true" : "false")"
     role="presentation">
  <button type="button" class="modal-backdrop" data-type="close" data-target="#eventitems-modal" tabindex="-1" aria-label="Close"></button>
  <div class="modal-panel edit-add-item-dialogue" role="dialog" aria-modal="true" aria-labelledby="eventitems-modal-title">
    <button
      type="button"
      id="eventitems-modal-dismiss"
      class="modal-dismiss modal-dismiss-corner"
      data-type="close"
      data-target="#eventitems-modal"
      aria-label="Close"
    >
      ×
    </button>

    <header class="modal-header">
      <span class="modal-header-icon" aria-hidden="true">
        <i class="fa-solid fa-box"></i>
      </span>
      <div class="modal-header-text">
        <h2 class="modal-title" id="eventitems-modal-title">Items to Bring</h2>
        <p class="modal-subtitle" id="eventitems-modal-subtitle">@(Model?.Title?.ToUpperInvariant())</p>
      </div>
    </header>

    @if (showModalFlash)
    {
      <p class="modal-success-message" id="eventitems-modal-flash" role="status">@modalFlash</p>
    }

    <div class="modal-content modal-content-items">
      <div id="eventitems-modal-list" class="modal-list">
        <div class="modal-list-scroll">
          <div id="eventitems-modal-rows" class="modal-list-rows">
            @if (items.Count == 0)
            {
              <p class="modal-empty">No items listed yet.</p>
            }
            @foreach (var item in items)
            {
              <partial name="~/Views/Shared/Partials/EventItemsPartials/_EventItemRow.cshtml"
                       model="(item, eventId, currentUserId, canManage, canClaimItems)" />
            }
          </div>
        </div>
      </div>
    </div>

    <div class="add-event-items-container">
      @if (canAddItems)
      {
      <button type="button" class="modal-content-add item" id="eventitems-modal-add" data-type="modal" data-target="#eventitem-add-item-modal" data-close-parent="#eventitems-modal" data-reset-add-item>
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>ADD AN ITEM</span>
      </button>
      }

      @if (canManage)
      {
      <div class="newtask-join-block" id="eventitem-items-guest-policy-row">
        <div class="newtask-join-copy">
          <label class="form-label" for="toggle-allow-items">Let people add their own items</label>
        </div>
        <label class="newitem-switch">
          <input type="checkbox" id="toggle-allow-items" name="allowGuestBringItems" value="1" @(Model?.AllowGuestBringItems == true ? "checked" : null) />
          <span class="newitem-switch-track" aria-hidden="true"></span>
        </label>
      </div>
      }

    </div>

    <footer class="modal-footer modal-footer-items">
      <button type="button" class="btn btn-save-item" id="eventitems-modal-save" data-type="close" data-target="#eventitems-modal">
        <span class="eventitem-join-label">DONE</span>
      </button>
    </footer>
  </div>
</div>
