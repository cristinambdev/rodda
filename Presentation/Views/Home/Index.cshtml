@model Presentation.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
    var hasTodos = Model.TodoEvents.Count > 0;
}

<!-- To-Dos (server-rendered; range via ?range=week|month|year) -->
<section class="home-section" aria-labelledby="todos-heading">
    <h2 class="section-header" id="todos-heading">My To-Dos</h2>
    <div class="home-todos-block">
        <div class="segmented-control" role="group" aria-label="To-do time range">
            <a class="segmented-control-option@(Model.ActiveRange == "week" ? " active" : "")"
               href="/index?range=week"
               aria-pressed="@(Model.ActiveRange == "week" ? "true" : "false")">This week</a>
            <a class="segmented-control-option@(Model.ActiveRange == "month" ? " active" : "")"
               href="/index?range=month"
               aria-pressed="@(Model.ActiveRange == "month" ? "true" : "false")">This month</a>
            <a class="segmented-control-option@(Model.ActiveRange == "year" ? " active" : "")"
               href="/index?range=year"
               aria-pressed="@(Model.ActiveRange == "year" ? "true" : "false")">This year</a>
        </div>
        @if (!hasTodos)
        {
            <p class="empty-state-card below-segment" aria-live="polite">@Model.EmptyMessage</p>
        }
        else
        {
            <ul class="todos-list">
                @foreach (var todoEvent in Model.TodoEvents)
                {
                    <partial name="~/Views/Shared/Partials/HomePartials/_HomeTodoEventCard.cshtml" model="todoEvent" />
                }
            </ul>
        }
    </div>
</section>

<!-- Calendar Highlights -->
<!-- Code generated with AI help -->
<section class="home-section" aria-labelledby="calendar-heading">
    <h2 class="section-header" id="calendar-heading">Calendar Highlights</h2>
    <!-- Mini calendar -->
    <div class="calendar-mini">
        <div class="calendar-mini-month-row">
            <button type="button" class="calendar-mini-month-nav" aria-label="Previous month">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>
            <p class="calendar-mini-month"></p>
            <button type="button" class="calendar-mini-month-nav" aria-label="Next month">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>
        <div class="calendar-mini-weekdays">
            <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
        </div>
        <div class="calendar-mini-grid"></div>
    </div>
</section>
<!-- Events from calendar-->
<section class="home-section" aria-labelledby="today-heading">
    <h4 class="section-subhead" id="today-heading"> Today, <span class="home-section-subhead-date"></span></h4>
    <p class="empty-state-card">No events today.</p>
</section>
<!-- Upcoming Events -->
<section class="home-section" aria-labelledby="upcoming-heading">
    <h2 class="section-header" id="upcoming-heading">Upcoming Events</h2>
    <div class="home-upcoming-block" data-home-upcoming>
        <div class="segmented-control" role="group" aria-label="Upcoming time range">
            <button type="button" class="segmented-control-option" data-event-range="week">This week</button>
            <button type="button" class="segmented-control-option active" data-event-range="month">This month</button>
            <button type="button" class="segmented-control-option" data-event-range="year">This year</button>
        </div>
        <p class="empty-state-card below-segment" data-event-empty>No events found.</p>
        <ul class="home-events-list" data-events-list hidden data-home-events-list></ul>
    </div>
</section>

<script type="application/json" id="portal-events-data">@Html.Raw(ViewData["PortalEventsJson"] ?? "[]")</script>

@section Scripts {
    <script src="~/js/events-portal.js" asp-append-version="true"></script>
    <script src="~/js/home-index.js" asp-append-version="true"></script>
}
